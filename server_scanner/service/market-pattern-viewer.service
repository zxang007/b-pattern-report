[Unit]
Description=Encrypted market scan report viewer
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/market-pattern-scanner/state
ExecStart=/usr/bin/python3 /home/ubuntu/market-pattern-scanner/web-current/report_server.py --root /home/ubuntu/market-pattern-scanner/state --port 443 --bind 127.0.0.1 --tls
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LoadCredentialEncrypted=report-key:/etc/credstore.encrypted/market-report.key
LoadCredentialEncrypted=tls-pem:/etc/credstore.encrypted/market-tls-pem.cred
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
