[Unit]
Description=Independent four-hour market pattern scanner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/market-pattern-scanner/current
Environment=MARKET_SCANNER_SERVER=qqbot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /home/ubuntu/market-pattern-scanner/current/scanner_service.py run --config /home/ubuntu/market-pattern-scanner/config.json
Restart=on-failure
RestartSec=15min
TimeoutStartSec=3h
Nice=10
CPUQuota=100%
MemoryHigh=700M
MemoryMax=950M
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/market-pattern-scanner/state
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
